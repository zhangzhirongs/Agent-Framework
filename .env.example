# Copy to .env. Values below are public placeholders, not service credentials.
AGENT_MODEL=deepseek-flash
# Optional comma-separated models shown in the chat model picker.
AGENT_MODELS=deepseek-flash,deepseek-v4-flash
# Optional vision-capable model; image uploads are routed to this model.
AGENT_VISION_MODEL=deepseek-flash
AGENT_API_KEY=sk-39d1d61e641a4d06a6ac5af5a3511737
AGENT_BASE_URL=https://api.deepseek.com
AGENT_API_MODE=chat
GEOFLOW_ROOT=D:\\Desktop\\各项目文件\\aicode\\GEOflow-zzr
GEOFLOW_PHP=php
# Optional: use PHP in an existing GEOFlow container for MCP.
# GEOFLOW_DOCKER_CONTAINER=geoflow-app
# GEOFLOW_ARTISAN_ENV=local
AGENT_GEOFLOW_BASE_URL=http://192.168.169.205:18082
AGENT_GEOFLOW_API_TOKEN=
AGENT_GEOFLOW_TIMEOUT=30
AGENT_GEOFLOW_VERIFY_TLS=true
AGENT_VISION_ENABLED=true
AGENT_MODEL_TIMEOUT=120
AGENT_MAX_TURNS=12
# Context guardrails: byte budgets include instructions, messages and loaded tool schemas.
# History is kept in storage; only recent complete turns are sent to the model.
AGENT_HISTORY_TURNS=8
AGENT_MAX_INPUT_BYTES=64000
AGENT_MAX_TOOL_OUTPUT_CHARS=8000
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_RUN_INPUT_BYTES=256000
AGENT_MAX_CONCURRENT_RUNS=2

# none | tavily | brave | searxng. Configure your own provider.
AGENT_SEARCH_PROVIDER=none
AGENT_SEARCH_API_KEY=
AGENT_SEARCH_BASE_URL=

# Demo account admin / 123 is created only on a new local development database.
# Set demo_account=false and deployment_mode=production for real deployment.
AGENT_DEPLOYMENT_MODE=development
AGENT_DEMO_ACCOUNT=true
AGENT_SECURE_COOKIE=false
# 默认仅本机访问；局域网访问前请先关闭体验账号并创建自己的管理员。
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
# Optional paths; relative paths resolve inside this project.
AGENT_DATA_DIR=data
AGENT_SKILLS_DIR=skills
AGENT_MCP_CONFIG=mcp.json
AGENT_MAX_UPLOAD_MB=20
# MCP server credentials are supplied by your own environment variables.
